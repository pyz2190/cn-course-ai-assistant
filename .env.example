# Web 开发服务器。留空时通过 Vite 的 /api 代理访问本地 API。
VITE_API_BASE_URL=

# 逗号分隔的浏览器来源，仅用于独立 Web 应用。
CN_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 默认离线模式无需密钥、网络或模型下载。
CN_AI_MODE=offline
CN_AI_VECTOR_STORE=memory
CN_AI_QDRANT_PATH=.data/qdrant
CN_AI_QDRANT_COLLECTION_PREFIX=cn_ai

# 离线组件；正式本地模型可改为 bge，并安装 apps/api[models]。
CN_AI_EMBEDDING_PROVIDER=offline
CN_AI_EMBEDDING_MODEL=BAAI/bge-m3
CN_AI_OFFLINE_EMBEDDING_DIMENSION=384
CN_AI_RERANKER_ENABLED=true
CN_AI_RERANKER_PROVIDER=offline
CN_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 外部生成可选。切换时设置 MODE=external、PROVIDER=openai-compatible 和 URL。
CN_AI_GENERATOR_PROVIDER=offline
CN_AI_GENERATOR_MODEL=offline-extractive-v1
CN_AI_MODEL_BASE_URL=
CN_AI_MODEL_API_KEY=

# 检索、降级与外部 HTTP 策略。
CN_AI_TOP_K=3
CN_AI_FETCH_K=8
CN_AI_MIN_RETRIEVAL_SCORE=0.15
CN_AI_ALLOW_DEGRADED=true
CN_AI_CONNECT_TIMEOUT_SECONDS=3
CN_AI_READ_TIMEOUT_SECONDS=30
CN_AI_WRITE_TIMEOUT_SECONDS=10
CN_AI_POOL_TIMEOUT_SECONDS=3
CN_AI_MAX_RETRIES=1
